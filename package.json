{
  "name": "invenio-modular-detail-page",
  "version": "0.3.1-dev1",
  "description": "ESLint tooling for invenio-modular-detail-page UI and translations. Install with pnpm only (matches KCWorks policy).",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=18",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "fsevents"
    ]
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/eslint-parser": "7.26.10",
    "@babel/preset-react": "7.28.5",
    "eslint": "8.57.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "4.6.2"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0 --ext .js,.jsx invenio_modular_detail_page/assets/semantic-ui/js invenio_modular_detail_page/assets/semantic-ui/translations/invenio_modular_detail_page",
    "preinstall": "npx only-allow pnpm"
  }
}
