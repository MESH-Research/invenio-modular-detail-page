{
  "name": "invenio-modular-detail-page",
  "version": "0.3.1-dev1",
  "description": "ESLint and Jest tooling for invenio-modular-detail-page UI and translations. Install with pnpm only (matches KCWorks policy).",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=18",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "fsevents"
    ]
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/eslint-parser": "7.26.10",
    "@babel/preset-env": "7.29.0",
    "@babel/preset-react": "7.28.5",
    "@testing-library/jest-dom": "5.17.0",
    "@testing-library/react": "12.1.5",
    "@testing-library/user-event": "12.8.3",
    "babel-jest": "29.7.0",
    "eslint": "8.57.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "4.6.2",
    "i18next": "20.3.0",
    "i18next-browser-languagedetector": "6.1.8",
    "identity-obj-proxy": "3.0.0",
    "jest": "27.5.1",
    "jest-environment-jsdom": "27.5.1",
    "react": "16.13.0",
    "react-dom": "16.13.0",
    "react-i18next": "11.18.6",
    "react-test-renderer": "16.13.0"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0 --ext .js,.jsx invenio_modular_detail_page/assets/semantic-ui/js invenio_modular_detail_page/assets/semantic-ui/translations/invenio_modular_detail_page",
    "preinstall": "npx only-allow pnpm",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:update": "jest -u",
    "test:file": "jest --testPathPattern"
  }
}
